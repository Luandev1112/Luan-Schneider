{% comment %}
    Add-to-cart popup for the Product Grid section.

    Accepts:
    - card_product: {Object} Product object to render.
    - dialog_id: {String} Unique id, matched by the trigger's data-dialog-open.

    Usage:
    {% render 'product-block-popup', card_product: card_product, dialog_id: dialog_id %}
{% endcomment %}

{% liquid
    assign current_variant = card_product.selected_or_first_available_variant

    for option in card_product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'colo'
            assign color_option = option
        elsif option_name contains 'size'
            assign size_option = option
        endif
    endfor
%}

<dialog class="product-block__dialog" id="{{ dialog_id }}" aria-label="{{ card_product.title | escape }}">
    <div class="product-block__dialog-inner">
        <button
            type="button"
            class="product-block__dialog-close"
            aria-label="Close"
            data-dialog-close
        >&times;</button>

        <div class="product-block__dialog-top">
            {% if card_product.featured_image %}
                <img
                    class="product-block__dialog-image"
                    src="{{ card_product.featured_image | image_url: width: 240 }}"
                    alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                    width="{{ card_product.featured_image.width }}"
                    height="{{ card_product.featured_image.height }}"
                    loading="lazy"
                >
            {% endif %}

            <div class="product-block__dialog-info">
                <span class="product-block__dialog-title">{{ card_product.title }}</span>
                <span class="product-block__dialog-price" data-variant-price>
                    {% if card_product.compare_at_price > card_product.price %}
                        <s class="product-block__dialog-price-compare">{{ card_product.compare_at_price | money }}</s>
                    {% endif %}
                    {{ card_product.price | money }}
                </span>
                {% if card_product.description != blank %}
                    <p class="product-block__dialog-description">
                        {{ card_product.description | strip_html | truncate: 120 }}
                    </p>
                {% endif %}
            </div>
        </div>

        {% form 'product', card_product, class: 'product-block__dialog-form' %}
            <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                data-variant-id
            >

            {% if color_option %}
                {% assign color_index = color_option.position | minus: 1 %}
                <fieldset class="product-block__dialog-fieldset">
                    <legend class="product-block__dialog-label">{{ color_option.name }}</legend>
                    <div class="product-block__dialog-swatches">
                        {% for value in color_option.values %}
                            {% liquid
                                if value.swatch.color != blank
                                    assign swatch_color = value.swatch.color
                                else
                                    assign swatch_color = value | downcase | replace: ' ', ''
                                endif
                            %}
                            <input
                                type="radio"
                                class="product-block__dialog-swatch-input"
                                id="Swatch-{{ dialog_id }}-{{ forloop.index }}"
                                name="Option{{ color_option.position }}-{{ dialog_id }}"
                                value="{{ value | escape }}"
                                data-option-position="{{ color_option.position }}"
                                {% if value == current_variant.options[color_index] %}checked{% endif %}
                            >
                            <label class="product-block__dialog-swatch" for="Swatch-{{ dialog_id }}-{{ forloop.index }}">
                                <span
                                    class="product-block__dialog-swatch-chip"
                                    style="--product-block-swatch-color: {{ swatch_color }};"
                                ></span>
                                <span class="product-block__dialog-swatch-name">{{ value }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            {% endif %}

            {% if size_option %}
                {% assign size_index = size_option.position | minus: 1 %}
                <div class="product-block__dialog-field">
                    <label class="product-block__dialog-label" for="Size-{{ dialog_id }}">{{ size_option.name }}</label>
                    <div class="product-block__dialog-select-wrap">
                        <select
                            class="product-block__dialog-select"
                            id="Size-{{ dialog_id }}"
                            data-option-position="{{ size_option.position }}"
                            required
                        >
                            <option value="" disabled selected>Choose your {{ size_option.name | downcase }}</option>
                            {% for value in size_option.values %}
                                <option value="{{ value | escape }}">{{ value }}</option>
                            {% endfor %}
                        </select>
                        <span class="product-block__dialog-select-arrow" aria-hidden="true">
                            <svg viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="1.5"/>
                            </svg>
                        </span>
                    </div>
                </div>
            {% endif %}

            {% comment %} Products whose options are neither colour nor size fall back to a plain variant list. {% endcomment %}
            {% unless color_option or size_option %}
                {% if card_product.variants.size > 1 %}
                    <div class="product-block__dialog-field">
                        <label class="product-block__dialog-label" for="Variant-{{ dialog_id }}">Variant</label>
                        <div class="product-block__dialog-select-wrap">
                            <select
                                class="product-block__dialog-select"
                                id="Variant-{{ dialog_id }}"
                                data-variant-select
                            >
                                {% for variant in card_product.variants %}
                                    <option
                                        value="{{ variant.id }}"
                                        {% unless variant.available %}disabled{% endunless %}
                                        {% if variant.id == current_variant.id %}selected{% endif %}
                                    >
                                        {{ variant.title }} - {{ variant.price | money }}
                                    </option>
                                {% endfor %}
                            </select>
                            <span class="product-block__dialog-select-arrow" aria-hidden="true">
                                <svg viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="1.5"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                {% endif %}
            {% endunless %}

            <button
                type="submit"
                class="product-block__dialog-submit"
                name="add"
                {% unless card_product.available %}disabled{% endunless %}
            >
                <span class="product-block__dialog-submit-text">
                    {% if card_product.available %}Add to cart{% else %}Sold out{% endif %}
                </span>
                {% render 'arrow-icon', size: 40 %}
            </button>
        {% endform %}

        <script type="application/json" data-variant-data>
            [
                {%- for variant in card_product.variants -%}
                    {
                        "id": {{ variant.id }},
                        "available": {{ variant.available }},
                        "options": {{ variant.options | json }},
                        "price": {{ variant.price | money | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
            ]
        </script>
    </div>
</dialog>
