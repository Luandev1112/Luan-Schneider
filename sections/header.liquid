{% liquid
    assign has_panel = false
    for block in section.blocks
        if block.type == 'announcement' or block.type == 'cta'
            assign has_panel = true
        endif
    endfor
%}

<div
    id="Header-{{ section.id }}"
    class="site-header"
    style="
        --site-header-background: {{ section.settings.background_color }};
        --site-header-padding: {{ section.settings.padding_vertical }}px;
        --site-header-padding-mobile: {{ section.settings.padding_vertical_mobile }}px;
        --site-header-height: {{ section.settings.header_height }}px;
        --site-header-height-mobile: {{ section.settings.header_height_mobile }}px;
        --site-header-gap: {{ section.settings.column_gap }}px;
    "
>
    <div class="site-header__inner">
        {% if has_panel %}
            <button
                type="button"
                class="site-header__toggle"
                aria-expanded="false"
                aria-controls="HeaderPanel-{{ section.id }}"
                aria-label="Menu"
                data-header-toggle
            >
                <span class="site-header__toggle-bar"></span>
                <span class="site-header__toggle-bar"></span>
                <span class="site-header__toggle-bar"></span>
            </button>
        {% endif %}

        {% for block in section.blocks %}
            {% if block.type == 'logo' %}
                    <div class="site-header__slot site-header__slot--logo" {{ block.shopify_attributes }}>
                        <a
                            class="site-header__logo"
                            href="{{ routes.root_url }}"
                            style="
                                --site-header-logo-color: {{ block.settings.logo_color }};
                                --site-header-logo-font-size: {{ block.settings.logo_font_size }}px;
                                --site-header-logo-height: {{ block.settings.logo_height }}px;
                                --site-header-logo-height-mobile: {{ block.settings.logo_height_mobile }}px;
                            "
                        >
                            {% if block.settings.logo_image %}
                                <img
                                    class="site-header__logo-image"
                                    src="{{ block.settings.logo_image | image_url: width: 600 }}"
                                    alt="{{ block.settings.logo_image.alt | default: shop.name | escape }}"
                                    width="{{ block.settings.logo_image.width }}"
                                    height="{{ block.settings.logo_image.height }}"
                                >
                            {% else %}
                                <span class="site-header__logo-text">
                                    {{ block.settings.logo_text | default: shop.name }}
                                </span>
                            {% endif %}
                        </a>
                    </div>
            {% endif %}
        {% endfor %}

        {% comment %}
            Announcement and CTA share one collapsible panel on mobile. On desktop the
            panel is display:contents, so both slots fall back into the header grid.
        {% endcomment %}
        {% if has_panel %}
            <div class="site-header__panel" id="HeaderPanel-{{ section.id }}">
                <div class="site-header__panel-inner">
                    {% for block in section.blocks %}
                        {% case block.type %}
                            {% when 'announcement' %}
                                <div
                                    class="site-header__slot site-header__slot--announcement{% if block.settings.hide_on_mobile %} site-header__slot--hide-mobile{% endif %}"
                                    style="
                                        --site-header-announcement-color: {{ block.settings.announcement_color }};
                                        --site-header-announcement-font-size: {{ block.settings.announcement_font_size }}px;
                                    "
                                    {{ block.shopify_attributes }}
                                >
                                    <p class="site-header__announcement">{{ block.settings.announcement_text }}</p>
                                </div>

                            {% when 'cta' %}
                                <div class="site-header__slot site-header__slot--cta" {{ block.shopify_attributes }}>
                                    <a
                                        class="site-header__cta"
                                        href="{{ block.settings.cta_link | default: '#' }}"
                                        style="
                                            --site-header-cta-background: {{ block.settings.cta_background_color }};
                                            --site-header-cta-color: {{ block.settings.cta_color }};
                                            --site-header-cta-hover-background: {{ block.settings.cta_hover_background_color }};
                                            --site-header-cta-hover-color: {{ block.settings.cta_hover_color }};
                                            --site-header-cta-font-size: {{ block.settings.cta_font_size }}px;
                                        "
                                    >
                                        <span class="site-header__cta-text">{{ block.settings.cta_text }}</span>
                                        {% if block.settings.cta_show_icon %}
                                            {% render 'arrow-icon', size: 28 %}
                                        {% endif %}
                                    </a>
                                </div>
                        {% endcase %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
    (() => {
        const header = document.getElementById('Header-{{ section.id }}');
        if (!header || header.dataset.toggleBound === 'true') return;
        header.dataset.toggleBound = 'true';

        const toggle = header.querySelector('[data-header-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
            const open = header.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(open));
        });
    })();
</script>

{% stylesheet %}
    .site-header {
        background-color: var(--site-header-background, #f5f5f5);
    }

    .site-header__inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--site-header-gap, 24px);
        padding: var(--site-header-padding, 16px) 24px;
        box-sizing: border-box;
        min-height: var(--site-header-height, 72px);
    }

    .site-header__slot--logo {
        grid-column: 1;
        justify-self: start;
    }

    .site-header__slot--announcement {
        grid-column: 2;
        justify-self: center;
    }

    .site-header__slot--cta {
        grid-column: 3;
        justify-self: end;
    }

    /* Desktop: the panel dissolves so its slots join the header grid directly. */
    .site-header__panel,
    .site-header__panel-inner {
        display: contents;
    }

    .site-header__toggle {
        display: none;
    }

    .site-header__logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--site-header-logo-color, #000000);
    }

    .site-header__logo-image {
        display: block;
        height: var(--site-header-logo-height, 32px);
        width: auto;
        object-fit: contain;
    }

    .site-header__logo-text {
        font-size: var(--site-header-logo-font-size, 24px);
        text-transform: uppercase;
        font-weight: 700;
        white-space: nowrap;
    }

    .site-header__announcement {
        margin: 0;
        font-size: var(--site-header-announcement-font-size, 14px);
        color: var(--site-header-announcement-color, #000000);
        text-align: center;
    }

    /* Same sweep treatment as the hero and add-to-cart buttons. */
    .site-header__cta {
        position: relative;
        z-index: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 12px 24px;
        background-color: var(--site-header-cta-background, #f5f000);
        color: var(--site-header-cta-color, #000000);
        font-size: var(--site-header-cta-font-size, 14px);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-decoration: none;
        overflow: hidden;
        transition: color 0.3s ease;
    }

    .site-header__cta::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: var(--site-header-cta-hover-background, #000000);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
    }

    .site-header__cta:hover {
        color: var(--site-header-cta-hover-color, #ffffff);
    }

    .site-header__cta:hover::before {
        transform: scaleX(1);
    }

    .site-header__cta svg {
        flex-shrink: 0;
    }

    @media screen and (max-width: 749px) {
        .site-header__inner {
            grid-template-columns: 1fr auto 1fr;
            grid-template-areas:
                "toggle logo ."
                "panel panel panel";
            align-items: center;
            column-gap: 12px;
            row-gap: 0;
            text-align: center;
            padding: var(--site-header-padding-mobile, 16px) 16px;
            min-height: var(--site-header-height-mobile, 64px);
        }

        .site-header__toggle {
            grid-area: toggle;
            justify-self: start;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            background: none;
            color: inherit;
            cursor: pointer;
        }

        /* Three bars that fold into an X — drawn, not a literal character. */
        .site-header__toggle-bar {
            display: block;
            width: 24px;
            height: 2px;
            background-color: currentColor;
            transition: transform 0.3s ease, opacity 0.2s ease;
        }

        .site-header.is-open .site-header__toggle-bar:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .site-header.is-open .site-header__toggle-bar:nth-child(2) {
            opacity: 0;
        }

        .site-header.is-open .site-header__toggle-bar:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .site-header__slot--logo {
            grid-area: logo;
            justify-self: center;
        }

        /* 0fr -> 1fr animates the reveal without hardcoding a height. */
        .site-header__panel {
            grid-area: panel;
            display: grid;
            grid-template-rows: 0fr;
            opacity: 0;
            transition: grid-template-rows 0.35s ease, opacity 0.25s ease;
        }

        .site-header.is-open .site-header__panel {
            grid-template-rows: 1fr;
            opacity: 1;
        }

        .site-header__panel-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            min-height: 0;
            overflow: hidden;
        }

        .site-header.is-open .site-header__panel-inner {
            padding-top: 16px;
        }

        .site-header__slot--announcement,
        .site-header__slot--cta {
            justify-self: center;
        }

        .site-header__slot--hide-mobile {
            display: none;
        }

        .site-header__logo-image {
            height: var(--site-header-logo-height-mobile, 28px);
        }
    }
{% endstylesheet %}

{% schema %}
  {
    "name": "Header",
    "tag": "header",
    "class": "site-header-wrapper",
    "settings": [
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#f5f5f5"
        },
        {
            "type": "range",
            "id": "header_height",
            "label": "Header Height",
            "info": "Minimum height. Grows if the content needs more room",
            "default": 72,
            "min": 40,
            "max": 200,
            "step": 4,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "header_height_mobile",
            "label": "Header Height (Mobile)",
            "info": "Minimum height. Grows if the content needs more room",
            "default": 64,
            "min": 40,
            "max": 200,
            "step": 4,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "padding_vertical",
            "label": "Vertical Padding",
            "default": 16,
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "padding_vertical_mobile",
            "label": "Vertical Padding (Mobile)",
            "default": 16,
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "column_gap",
            "label": "Column Gap",
            "default": 24,
            "min": 0,
            "max": 80,
            "step": 4,
            "unit": "px"
        }
    ],
    "blocks": [
        {
            "type": "logo",
            "name": "Logo",
            "limit": 1,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logo_image",
                    "label": "Logo Image",
                    "info": "Optional. Falls back to the logo text below"
                },
                {
                    "type": "range",
                    "id": "logo_height",
                    "label": "Logo Image Height",
                    "default": 19,
                    "min": 16,
                    "max": 120,
                    "step": 2,
                    "unit": "px"
                },
                {
                    "type": "range",
                    "id": "logo_height_mobile",
                    "label": "Logo Image Height (Mobile)",
                    "default": 18,
                    "min": 16,
                    "max": 120,
                    "step": 2,
                    "unit": "px"
                },
                {
                    "type": "text",
                    "id": "logo_text",
                    "label": "Logo Text",
                    "info": "Used when no logo image is set. Defaults to the store name"
                },
                {
                    "type": "range",
                    "id": "logo_font_size",
                    "label": "Logo Font Size",
                    "default": 24,
                    "min": 12,
                    "max": 60,
                    "step": 1,
                    "unit": "px"
                },
                {
                    "type": "color",
                    "id": "logo_color",
                    "label": "Logo Color",
                    "default": "#000000"
                }
            ]
        },
        {
            "type": "announcement",
            "name": "Announcement",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "announcement_text",
                    "label": "Text",
                    "default": "Find the ideal gift for your loved ones."
                },
                {
                    "type": "range",
                    "id": "announcement_font_size",
                    "label": "Font Size",
                    "default": 14,
                    "min": 10,
                    "max": 32,
                    "step": 1,
                    "unit": "px"
                },
                {
                    "type": "color",
                    "id": "announcement_color",
                    "label": "Text Color",
                    "default": "#000000"
                },
                {
                    "type": "checkbox",
                    "id": "hide_on_mobile",
                    "label": "Hide on Mobile",
                    "default": false
                }
            ]
        },
        {
            "type": "cta",
            "name": "CTA",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "cta_text",
                    "label": "Button Text",
                    "default": "Choose gift"
                },
                {
                    "type": "url",
                    "id": "cta_link",
                    "label": "Button Link"
                },
                {
                    "type": "range",
                    "id": "cta_font_size",
                    "label": "Button Font Size",
                    "default": 14,
                    "min": 10,
                    "max": 32,
                    "step": 1,
                    "unit": "px"
                },
                {
                    "type": "color",
                    "id": "cta_background_color",
                    "label": "Button Background",
                    "default": "#f5f000"
                },
                {
                    "type": "color",
                    "id": "cta_color",
                    "label": "Button Text Color",
                    "default": "#000000"
                },
                {
                    "type": "checkbox",
                    "id": "cta_show_icon",
                    "label": "Show Arrow Icon",
                    "default": true
                },
                {
                    "type": "header",
                    "content": "Hover Animation"
                },
                {
                    "type": "color",
                    "id": "cta_hover_background_color",
                    "label": "Hover Background",
                    "default": "#000000"
                },
                {
                    "type": "color",
                    "id": "cta_hover_color",
                    "label": "Hover Text Color",
                    "default": "#ffffff"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Header",
            "blocks": [
                {
                    "type": "logo"
                },
                {
                    "type": "announcement"
                },
                {
                    "type": "cta"
                }
            ]
        }
    ]
  }
{% endschema %}
