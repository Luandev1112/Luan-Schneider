<div
    id="Product-block-{{ section.id }}"
    class="product-block"
    style="
        --product-block-columns-desktop: {{ section.settings.columns_desktop }};
        --product-block-columns-mobile: {{ section.settings.columns_mobile }};
        --product-block-gap: {{ section.settings.grid_gap }}px;
        --product-block-image-ratio: {{ section.settings.image_ratio }};
        --product-block-heading-align: {{ section.settings.heading_align }};
        --product-block-heading-font-size: {{ section.settings.heading_font_size }}px;
        --product-block-heading-color: {{ section.settings.heading_color }};
        --product-block-focal-size: {{ section.settings.focal_point_size }}px;
        --product-block-focal-background-color: {{ section.settings.focal_point_background_color }};
        --product-block-focal-icon-color: {{ section.settings.focal_point_icon_color }};
    "
>
    {% if section.settings.heading != blank %}
        <h2 class="product-block__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
        <ul class="product-block__list" role="list">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'product' %}
                        {% liquid
                            assign card_product = block.settings.product

                            assign focal_point = card_product.featured_media.presentation.focal_point
                            if focal_point == blank
                                assign focal_point = '50% 50%'
                            endif
                            assign focal_parts = focal_point | split: ' '
                            assign focal_x = focal_parts[0] | default: '50%'
                            assign focal_y = focal_parts[1] | default: '50%'
                        %}
                        {% assign dialog_id = 'ProductDialog-' | append: section.id | append: '-' | append: block.id %}
                        <li class="product-block__card" {{ block.shopify_attributes }}>
                            {% if card_product != blank %}
                                <div class="product-block__media">
                                    {% if card_product.featured_image %}
                                        <img
                                            class="product-block__image"
                                            src="{{ card_product.featured_image | image_url: width: 800 }}"
                                            alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                                            width="{{ card_product.featured_image.width }}"
                                            height="{{ card_product.featured_image.height }}"
                                            loading="lazy"
                                            style="--product-block-image-focal: {{ focal_point }};"
                                        >
                                    {% else %}
                                        {{ 'product-1' | placeholder_svg_tag: 'product-block__placeholder' }}
                                    {% endif %}

                                    {% if section.settings.show_focal_point and card_product.featured_image %}
                                        <button
                                            type="button"
                                            class="product-block__focal-point"
                                            style="
                                                --product-block-focal-x: {{ focal_x }};
                                                --product-block-focal-y: {{ focal_y }};
                                            "
                                            aria-haspopup="dialog"
                                            aria-label="Add {{ card_product.title | escape }} to cart"
                                            data-dialog-open="{{ dialog_id }}"
                                        ></button>
                                    {% endif %}
                                </div>

                                {% render 'product-block-popup', card_product: card_product, dialog_id: dialog_id %}
                            {% else %}
                                <div class="product-block__media">
                                    {{ 'product-1' | placeholder_svg_tag: 'product-block__placeholder' }}
                                </div>
                            {% endif %}
                        </li>
                {% endcase %}
            {% endfor %}
        </ul>
    {% endif %}
</div>

<script>
    (() => {
        const section = document.getElementById('Product-block-{{ section.id }}');
        if (!section || section.dataset.dialogsBound === 'true') return;
        section.dataset.dialogsBound = 'true';

        section.addEventListener('click', (event) => {
            const trigger = event.target.closest('[data-dialog-open]');
            if (trigger) {
                const dialog = section.querySelector('#' + CSS.escape(trigger.dataset.dialogOpen));
                if (dialog) dialog.showModal();
                return;
            }

            if (event.target.closest('[data-dialog-close]')) {
                event.target.closest('dialog').close();
            }
        });

        section.querySelectorAll('.product-block__dialog').forEach((dialog) => {
            dialog.addEventListener('click', (event) => {
                if (event.target === dialog) dialog.close();
            });
        });
    })();
</script>

{% stylesheet %}
    .product-block {
        padding: 40px 55px;
    }

    .product-block__heading {
        margin: 0 0 24px;
        font-size: var(--product-block-heading-font-size, 32px);
        color: var(--product-block-heading-color, #000000);
        text-align: var(--product-block-heading-align, left);
        font-family: Lustria;
    }

    .product-block__list {
        display: grid;
        grid-template-columns: repeat(var(--product-block-columns-desktop, 4), minmax(0, 1fr));
        gap: var(--product-block-gap, 16px);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .product-block__card {
        display: flex;
        flex-direction: column;
    }

    .product-block__media {
        position: relative;
        aspect-ratio: var(--product-block-image-ratio, 1);
        overflow: hidden;
    }

    .product-block__image,
    .product-block__placeholder {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--product-block-image-focal, center center);
        transition: transform 0.4s ease;
    }

    .product-block__media:hover .product-block__image {
        transform: scale(1.04);
    }

    .product-block__focal-point {
        position: absolute;
        top: var(--product-block-focal-y, 50%);
        left: var(--product-block-focal-x, 50%);
        transform: translate(-50%, -50%);
        width: var(--product-block-focal-size, 40px);
        height: var(--product-block-focal-size, 40px);
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: var(--product-block-focal-background-color, #ffffff);
        cursor: pointer;
    }

    .product-block__focal-point::before,
    .product-block__focal-point::after {
        content: '';
        position: absolute;
        inset: 0;
        margin: auto;
        background-color: var(--product-block-focal-icon-color, #000000);
    }

    .product-block__focal-point::before {
        width: 40%;
        height: 2px;
    }

    .product-block__focal-point::after {
        width: 2px;
        height: 40%;
    }

    .product-block__dialog {
        width: min(440px, calc(100vw - 32px));
        padding: 0;
        border: none;
        background-color: #ffffff;
        color: #000000;
    }

    .product-block__dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .product-block__dialog-inner {
        position: relative;
        display: flex;
        gap: 16px;
        padding: 24px;
    }

    .product-block__dialog-close {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        background: none;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .product-block__dialog-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .product-block__dialog-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .product-block__dialog-title {
        font-size: 16px;
        padding-right: 32px;
    }

    .product-block__dialog-price {
        display: flex;
        gap: 8px;
        font-size: 14px;
    }

    .product-block__dialog-price-compare {
        opacity: 0.6;
    }

    .product-block__dialog-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .product-block__dialog-label {
        font-size: 12px;
        text-transform: uppercase;
    }

    .product-block__dialog-select {
        padding: 8px;
    }

    .product-block__dialog-submit {
        padding: 12px 24px;
        border: 1px solid currentColor;
        background-color: #000000;
        color: #ffffff;
        text-transform: uppercase;
        cursor: pointer;
    }

    .product-block__dialog-sold-out {
        font-size: 14px;
        opacity: 0.6;
    }

    .product-block__dialog-link {
        font-size: 12px;
        color: inherit;
    }

    @media screen and (max-width: 749px) {
        .product-block {
            padding: 24px 16px;
        }

        .product-block__list {
            grid-template-columns: repeat(var(--product-block-columns-mobile, 2), minmax(0, 1fr));
        }
    }
{% endstylesheet %}

{% schema %}
  {
    "name": "Product Grid",
    "tag": "section",
    "class": "product-block-wrapper section-wrapper",
    "max_blocks": 24,
    "settings": [
        {
            "type": "header",
            "content": "Heading"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Featured products"
        },
        {
            "type": "range",
            "id": "heading_font_size",
            "label": "Heading Font Size",
            "default": 32,
            "min": 12,
            "max": 80,
            "step": 1,
            "unit": "px"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#000000"
        },
        {
            "type": "select",
            "id": "heading_align",
            "label": "Heading Alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns_desktop",
            "label": "Columns (Desktop)",
            "default": 4,
            "min": 1,
            "max": 6,
            "step": 1
        },
        {
            "type": "range",
            "id": "columns_mobile",
            "label": "Columns (Mobile)",
            "default": 2,
            "min": 1,
            "max": 3,
            "step": 1
        },
        {
            "type": "range",
            "id": "grid_gap",
            "label": "Grid Gap",
            "default": 16,
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "select",
            "id": "image_ratio",
            "label": "Image Ratio",
            "options": [
                {
                    "value": "1",
                    "label": "Square"
                },
                {
                    "value": "3 / 4",
                    "label": "Portrait"
                },
                {
                    "value": "4 / 3",
                    "label": "Landscape"
                }
            ],
            "default": "1"
        },
        {
            "type": "header",
            "content": "Focal Point"
        },
        {
            "type": "checkbox",
            "id": "show_focal_point",
            "label": "Show Focal Point",
            "info": "Marks each image's focal point, set in the Shopify media editor",
            "default": true
        },
        {
            "type": "range",
            "id": "focal_point_size",
            "label": "Focal Point Size",
            "default": 40,
            "min": 20,
            "max": 80,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "color",
            "id": "focal_point_background_color",
            "label": "Focal Point Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "focal_point_icon_color",
            "label": "Focal Point Icon Color",
            "default": "#000000"
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Product Grid",
            "blocks": [
                {
                    "type": "product"
                },
                {
                    "type": "product"
                },
                {
                    "type": "product"
                },
                {
                    "type": "product"
                }
            ]
        }
    ]
  }
{% endschema %}
