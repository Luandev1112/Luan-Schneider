<div
    id="Product-block-{{ section.id }}"
    class="product-block"
    style="
        --product-block-columns-desktop: {{ section.settings.columns_desktop }};
        --product-block-columns-mobile: {{ section.settings.columns_mobile }};
        --product-block-gap: {{ section.settings.grid_gap }}px;
        --product-block-gap-mobile: {{ section.settings.grid_gap_mobile }}px;
        --product-block-image-ratio: {{ section.settings.image_ratio }};
        --product-block-heading-align: {{ section.settings.heading_align }};
        --product-block-heading-font-size: {{ section.settings.heading_font_size }}px;
        --product-block-heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
        --product-block-heading-color: {{ section.settings.heading_color }};
        --product-block-focal-size: {{ section.settings.focal_point_size }}px;
        --product-block-focal-size-mobile: {{ section.settings.focal_point_size_mobile }}px;
        --product-block-focal-background-color: {{ section.settings.focal_point_background_color }};
        --product-block-focal-icon-color: {{ section.settings.focal_point_icon_color }};
    "
>
    {% if section.settings.heading != blank %}
        <h2 class="product-block__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
        <ul class="product-block__list" role="list">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'product' %}
                        {% liquid
                            assign card_product = block.settings.product

                            assign focal_point = card_product.featured_media.presentation.focal_point
                            if focal_point == blank
                                assign focal_point = '50% 50%'
                            endif
                            assign focal_parts = focal_point | split: ' '
                            assign focal_x = focal_parts[0] | default: '50%'
                            assign focal_y = focal_parts[1] | default: '50%'
                        %}
                        {% assign dialog_id = 'ProductDialog-' | append: section.id | append: '-' | append: block.id %}
                        <li class="product-block__card" {{ block.shopify_attributes }}>
                            {% if card_product != blank %}
                                <div class="product-block__media">
                                    {% if card_product.featured_image %}
                                        <img
                                            class="product-block__image"
                                            src="{{ card_product.featured_image | image_url: width: 800 }}"
                                            alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                                            width="{{ card_product.featured_image.width }}"
                                            height="{{ card_product.featured_image.height }}"
                                            loading="lazy"
                                            style="--product-block-image-focal: {{ focal_point }};"
                                        >
                                    {% else %}
                                        {{ 'product-1' | placeholder_svg_tag: 'product-block__placeholder' }}
                                    {% endif %}

                                    {% if section.settings.show_focal_point and card_product.featured_image %}
                                        <button
                                            type="button"
                                            class="product-block__focal-point"
                                            style="
                                                --product-block-focal-x: {{ focal_x }};
                                                --product-block-focal-y: {{ focal_y }};
                                            "
                                            aria-haspopup="dialog"
                                            aria-label="Add {{ card_product.title | escape }} to cart"
                                            data-dialog-open="{{ dialog_id }}"
                                        ></button>
                                    {% endif %}
                                </div>

                                {% render 'product-block-popup', card_product: card_product, dialog_id: dialog_id %}
                            {% else %}
                                <div class="product-block__media">
                                    {{ 'product-1' | placeholder_svg_tag: 'product-block__placeholder' }}
                                </div>
                            {% endif %}
                        </li>
                {% endcase %}
            {% endfor %}
        </ul>
    {% endif %}
</div>

<script>
    (() => {
        const section = document.getElementById('Product-block-{{ section.id }}');
        if (!section || section.dataset.dialogsBound === 'true') return;
        section.dataset.dialogsBound = 'true';

        section.addEventListener('click', (event) => {
            const trigger = event.target.closest('[data-dialog-open]');
            if (trigger) {
                const dialog = section.querySelector('#' + CSS.escape(trigger.dataset.dialogOpen));
                if (dialog) dialog.showModal();
                return;
            }

            if (event.target.closest('[data-dialog-close]')) {
                event.target.closest('dialog').close();
            }
        });

        section.querySelectorAll('.product-block__dialog').forEach((dialog) => {
            dialog.addEventListener('click', (event) => {
                if (event.target === dialog) dialog.close();
            });
        });

        const dataEl = (dialog) => dialog.querySelector('[data-variant-data]');

        const syncVariant = (dialog) => {
            const idInput = dialog.querySelector('[data-variant-id]');
            const submit = dialog.querySelector('.product-block__dialog-submit');
            if (!idInput || !submit) return;

            // Label lives in its own span so updating it never removes the arrow icon.
            const label = submit.querySelector('.product-block__dialog-submit-text');
            const setState = (text, disabled) => {
                if (label) label.textContent = text;
                submit.disabled = disabled;
            };

            // Fallback markup picks the variant id directly.
            const variantSelect = dialog.querySelector('[data-variant-select]');
            if (variantSelect) {
                idInput.value = variantSelect.value;
                return;
            }

            const json = dataEl(dialog);
            if (!json) return;

            let variants;
            try {
                variants = JSON.parse(json.textContent);
            } catch (error) {
                return;
            }

            const controls = [...dialog.querySelectorAll('[data-option-position]')];
            const positions = new Set(controls.map((control) => control.dataset.optionPosition));

            const chosen = {};
            controls.forEach((control) => {
                if (control.type === 'radio' && !control.checked) return;
                if (!control.value) return;
                chosen[control.dataset.optionPosition] = control.value;
            });

            // Nothing to resolve until every option has a value; `required` blocks submission meanwhile.
            if (Object.keys(chosen).length < positions.size) {
                setState('Add to cart', false);
                return;
            }

            const match = variants.find((variant) =>
                Object.entries(chosen).every(([position, value]) => variant.options[position - 1] === value)
            );

            if (!match) {
                setState('Unavailable', true);
                return;
            }

            idInput.value = match.id;
            setState(match.available ? 'Add to cart' : 'Sold out', !match.available);

            const price = dialog.querySelector('[data-variant-price]');
            if (price) price.textContent = match.price;
        };

        // Slides the black square to whichever swatch is now selected.
        const moveSwatchIndicator = (input) => {
            const group = input.closest('.product-block__dialog-swatches');
            if (!group) return;
            const inputs = [...group.querySelectorAll('.product-block__dialog-swatch-input')];
            group.style.setProperty('--product-block-swatch-index', inputs.indexOf(input));
        };

        section.addEventListener('change', (event) => {
            const swatch = event.target.closest('.product-block__dialog-swatch-input');
            if (swatch) moveSwatchIndicator(swatch);

            const dialog = event.target.closest('.product-block__dialog');
            if (dialog) syncVariant(dialog);
        });
    })();
</script>

{% stylesheet %}
    .product-block {
        padding: 40px 55px;
    }

    .product-block__heading {
        margin: 0 0 24px;
        font-size: var(--product-block-heading-font-size, 32px);
        color: var(--product-block-heading-color, #000000);
        text-align: var(--product-block-heading-align, left);
        font-family: Lustria;
    }

    .product-block__list {
        display: grid;
        grid-template-columns: repeat(var(--product-block-columns-desktop, 4), minmax(0, 1fr));
        gap: var(--product-block-gap, 16px);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .product-block__card {
        display: flex;
        flex-direction: column;
    }

    .product-block__media {
        position: relative;
        aspect-ratio: var(--product-block-image-ratio, 1);
        overflow: hidden;
    }

    .product-block__image,
    .product-block__placeholder {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--product-block-image-focal, center center);
        transition: transform 0.4s ease;
    }

    .product-block__media:hover .product-block__image {
        transform: scale(1.04);
    }

    .product-block__focal-point {
        position: absolute;
        top: var(--product-block-focal-y, 50%);
        left: var(--product-block-focal-x, 50%);
        transform: translate(-50%, -50%);
        width: var(--product-block-focal-size, 40px);
        height: var(--product-block-focal-size, 40px);
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: var(--product-block-focal-background-color, #ffffff);
        cursor: pointer;
    }

    .product-block__focal-point::before,
    .product-block__focal-point::after {
        content: '';
        position: absolute;
        inset: 0;
        margin: auto;
        background-color: var(--product-block-focal-icon-color, #000000);
    }

    .product-block__focal-point::before {
        width: 40%;
        height: 2px;
    }

    .product-block__focal-point::after {
        width: 2px;
        height: 40%;
    }

    .product-block__dialog {
        width: 331px;
        /* height: 447px; */
        max-width: calc(100vw - 32px);
        max-height: calc(100vh - 32px);
        padding: 0;
        border: none;
        background-color: #ffffff;
        color: #000000;
    }

    .product-block__dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .product-block__dialog-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-sizing: border-box;
        height: 100%;
        padding: 28px 16px;
        overflow-y: auto;
    }

    .product-block__dialog-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        background: none;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
    }

    .product-block__dialog-top {
        display: flex;
        gap: 12px;
    }

    .product-block__dialog-image {
        width: 120px;
        height: 140px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .product-block__dialog-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        justify-content: space-between;
    }

    .product-block__dialog-title {
        font-size: 16px;
        line-height: 1.2;
        padding-right: 20px;
    }

    .product-block__dialog-price {
        display: flex;
        gap: 8px;
        font-size: 16px;
        font-family: Lustria;
    }

    .product-block__dialog-price-compare {
        opacity: 0.6;
    }

    .product-block__dialog-description {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        opacity: 0.7;
    }

    .product-block__dialog-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        flex-grow: 1;
    }

    .product-block__dialog-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .product-block__dialog-label {
        display: block;
        font-size: 14px;
        padding: 0;
    }

    .product-block__dialog-fieldset {
        margin: 0;
        padding: 0;
        border: none;
    }

    .product-block__dialog-swatches {
        position: relative;
        z-index: 0;
        display: flex;
        margin-top: 6px;
        border: 1px solid #000000;
        overflow: hidden;
    }

    /* Single black square that slides between swatches. */
    .product-block__dialog-swatches::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: -1;
        width: calc(100% / var(--product-block-swatch-count, 1));
        background-color: #000000;
        transform: translateX(calc(100% * var(--product-block-swatch-index, 0)));
        transition: transform 0.3s ease;
    }

    .product-block__dialog-swatch-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .product-block__dialog-swatch {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        border-right: 1px solid #000000;
        font-size: 16px;
        cursor: pointer;
        height: 40px;
        transition: color 0.3s ease;
    }

    .product-block__dialog-swatch:last-of-type {
        border-right: none;
    }

    .product-block__dialog-swatch-chip {
        width: 5px;
        height: 100%;
        flex-shrink: 0;
        background-color: var(--product-block-swatch-color, transparent);
        border-right: 1px solid rgba(0, 0, 0, 0.15);
    }

    .product-block__dialog-swatch-name {
        padding: 12px 4px 12px 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .product-block__dialog-swatch-input:checked + .product-block__dialog-swatch {
        color: #ffffff;
    }

    .product-block__dialog-swatch-input:focus-visible + .product-block__dialog-swatch {
        outline: 2px solid #000000;
        outline-offset: -2px;
    }

    .product-block__dialog-select-wrap {
        position: relative;
        display: flex;
        align-items: stretch;
        border: 1px solid #000000;
    }

    .product-block__dialog-select {
        flex: 1 1 auto;
        min-width: 0;
        padding-left: 14px;
        border: none;
        border-radius: 0;
        background: none;
        font-size: 16px;
        color: inherit;
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
        height: 40px;
        outline: unset;
    }

    .product-block__dialog-select-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        flex-shrink: 0;
        border-left: 1px solid #000000;
        pointer-events: none;
    }

    .product-block__dialog-select-arrow svg {
        width: 16px;
        height: 10px;
    }

    .product-block__dialog-submit {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        /* min-height: 56px; */
        padding: 0px 24px;
        border: none;
        background-color: #000;
        color: #fff;
        font-size: 16px;
        letter-spacing: .05em;
        text-transform: uppercase;
        cursor: pointer;
        height: 45px;
        margin-top: 24px;
    }


    .product-block__dialog-submit span,
    .product-block__dialog-submit svg {
        position: relative;
        top: 1px;
    }
    .product-block__dialog-submit svg {
        flex-shrink: 0;
    }

    .product-block__dialog-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @media screen and (max-width: 749px) {
        .product-block__heading {
            text-align: center;
        }
        .product-block {
            padding: 24px 16px;
        }

        .product-block__heading {
            font-size: var(--product-block-heading-font-size-mobile, 24px);
        }

        .product-block__list {
            grid-template-columns: repeat(var(--product-block-columns-mobile, 2), minmax(0, 1fr));
            gap: var(--product-block-gap-mobile, 12px);
        }

        .product-block__focal-point {
            width: var(--product-block-focal-size-mobile, 28px);
            height: var(--product-block-focal-size-mobile, 28px);
        }
    }
{% endstylesheet %}

{% schema %}
  {
    "name": "Product Grid",
    "tag": "section",
    "class": "product-block-wrapper section-wrapper",
    "max_blocks": 24,
    "settings": [
        {
            "type": "header",
            "content": "Heading"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Featured products"
        },
        {
            "type": "range",
            "id": "heading_font_size",
            "label": "Heading Font Size",
            "default": 32,
            "min": 12,
            "max": 80,
            "step": 1,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "heading_font_size_mobile",
            "label": "Heading Font Size (Mobile)",
            "default": 24,
            "min": 12,
            "max": 80,
            "step": 1,
            "unit": "px"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#000000"
        },
        {
            "type": "select",
            "id": "heading_align",
            "label": "Heading Alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns_desktop",
            "label": "Columns (Desktop)",
            "default": 4,
            "min": 1,
            "max": 6,
            "step": 1
        },
        {
            "type": "range",
            "id": "columns_mobile",
            "label": "Columns (Mobile)",
            "default": 2,
            "min": 1,
            "max": 3,
            "step": 1
        },
        {
            "type": "range",
            "id": "grid_gap",
            "label": "Grid Gap",
            "default": 16,
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "grid_gap_mobile",
            "label": "Grid Gap (Mobile)",
            "default": 12,
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "select",
            "id": "image_ratio",
            "label": "Image Ratio",
            "options": [
                {
                    "value": "1",
                    "label": "Square"
                },
                {
                    "value": "3 / 4",
                    "label": "Portrait"
                },
                {
                    "value": "4 / 3",
                    "label": "Landscape"
                }
            ],
            "default": "1"
        },
        {
            "type": "header",
            "content": "Focal Point"
        },
        {
            "type": "checkbox",
            "id": "show_focal_point",
            "label": "Show Focal Point",
            "info": "Marks each image's focal point, set in the Shopify media editor",
            "default": true
        },
        {
            "type": "range",
            "id": "focal_point_size",
            "label": "Focal Point Size",
            "default": 40,
            "min": 20,
            "max": 80,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "focal_point_size_mobile",
            "label": "Focal Point Size (Mobile)",
            "default": 28,
            "min": 12,
            "max": 80,
            "step": 2,
            "unit": "px"
        },
        {
            "type": "color",
            "id": "focal_point_background_color",
            "label": "Focal Point Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "focal_point_icon_color",
            "label": "Focal Point Icon Color",
            "default": "#000000"
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Product Grid",
            "blocks": [
                {
                    "type": "product"
                },
                {
                    "type": "product"
                },
                {
                    "type": "product"
                },
                {
                    "type": "product"
                }
            ]
        }
    ]
  }
{% endschema %}
