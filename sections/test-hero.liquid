{% liquid
    assign hero_image = section.settings.hero_image

    assign horizontal_position = section.settings.hero_content_horizontal_position | default: 'center'
    case horizontal_position
        when 'left'
            assign horizontal_position_css = 'flex-start'
        when 'right'
            assign horizontal_position_css = 'flex-end'
        else
            assign horizontal_position_css = 'center'
    endcase

    assign vertical_position = section.settings.hero_content_vertical_position | default: 'center'
    case vertical_position
        when 'top'
            assign vertical_position_css = 'flex-start'
        when 'bottom'
            assign vertical_position_css = 'flex-end'
        else
            assign vertical_position_css = 'center'
    endcase
%}

<div
    id="Test-hero-{{ section.id }}"
    class="test-hero"
    style="
        --test-hero-horizontal-position: {{ horizontal_position_css }};
        --test-hero-vertical-position: {{ vertical_position_css }};
        --test-hero-text-align: {{ horizontal_position }};
        --test-hero-content-max-width: {{ section.settings.hero_content_max_width }}px;
        --test-hero-image-height: {{ section.settings.hero_image_height }}vh;
    "
>
    <div class="test-hero__image">
        <img src="{{ hero_image | img_url: 'master' | width: 1400 }}" alt="{{ section.settings.hero_title }}">
    </div>
    <div class="test-hero__content">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'title' %}
                    <h2
                        class="test-hero__title"
                        style="color: {{ block.settings.block_title_color }}; font-size: {{ block.settings.block_title_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.block_title }}
                    </h2>
                {% when 'text' %}
                    <p
                        class="test-hero__text"
                        style="color: {{ block.settings.block_text_color }}; font-size: {{ block.settings.block_text_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.block_text }}
                    </p>
                {% when 'button' %}
                    <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="test-hero__button"
                        style="color: {{ block.settings.button_color }}; background-color: {{ block.settings.button_background_color }}; font-size: {{ block.settings.button_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.button_text }}
                        {% if block.settings.button_show_icon %}
                            <span class="test-hero__button-icon">
                                {% render 'arrow-icon' %}
                            </span>
                        {% endif %}
                    </a>
            {% endcase %}
        {% endfor %}
    </div>
</div>


{% stylesheet %}
    .test-hero {
        position: relative;
        min-height: var(--test-hero-image-height, 60vh);
        overflow: hidden;
        display: flex;
        align-items: var(--test-hero-vertical-position, center);
        justify-content: var(--test-hero-horizontal-position, center);
    }

    .test-hero__image {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .test-hero__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
    }

    .test-hero__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: var(--test-hero-horizontal-position, center);
        gap: 16px;
        text-align: var(--test-hero-text-align, center);
        justify-content: center;
        margin: 40px 65px;
        width: 100%;
        max-width: var(--test-hero-content-max-width, 800px);
    }

    .test-hero__title,
    .test-hero__text {
        margin: 0;
    }

    .test-hero__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        border: 1px solid currentColor;
        /* padding: 12px 24px; */
        width: 220px;
        height: 50px;
    }

    .test-hero__button-icon {
        display: inline-flex;
        align-items: center;
        text-transform: uppercase;
    }
{% endstylesheet %}

{% schema %}
  {
    "name": "Test Hero",
    "tag": "section",
    "class": "test-hero-warpper section-wrapper",
    "settings": [
        {
            "type": "header",
            "content": "Test Hero"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero Image"
        },
        {
            "type": "range",
            "id": "hero_image_height",
            "label": "Hero Image Height",
            "default": 60,
            "min": 30,
            "max": 100,
            "step": 5,
            "unit": "vh"
        },
        {
            "type": "range",
            "id": "hero_content_max_width",
            "label": "Hero Content Max Width",
            "default": 800,
            "min": 200,
            "max": 1000,
            "step": 10,
            "unit": "px"
        },
        {
            "type": "header",
            "content": "Content Position"
        },
        {
            "type": "select",
            "id": "hero_content_vertical_position",
            "label": "Vertical Position",
            "options": [
                {
                    "value": "top",
                    "label": "Top"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "bottom",
                    "label": "Bottom"
                }
            ],
            "default": "center"
        },
        {
            "type": "select",
            "id": "hero_content_horizontal_position",
            "label": "Horizontal Position",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "center"
        }
    ],
    "blocks": [
        {
            "type": "title",
            "name": "Title",
            "settings": [
                {
                    "type": "text",
                    "id": "block_title",
                    "label": "Block Title"
                },
                {
                    "type": "color",
                    "id": "block_title_color",
                    "label": "Title color",
                    "default": "#000000"
                },
                {
                    "type": "range",
                    "id": "block_title_font_size",
                    "label": "Block Title Font Size",
                    "default": 48,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "text",
            "name": "Description",
            "settings": [
                {
                    "type": "text",
                    "id": "block_text",
                    "label": "Block Text"
                },
                {
                    "type": "color",
                    "id": "block_text_color",
                    "label": "Text color",
                    "default": "#000000"
                },
                {
                    "type": "range",
                    "id": "block_text_font_size",
                    "label": "Block Text Font Size",
                    "default": 16,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "button",
            "name": "Button",
            "settings": [
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button Text"
                },
                {
                    "type": "url",
                    "id": "button_link",
                    "label": "Button Link"
                },
                {
                    "type": "color",
                    "id": "button_color",
                    "default": "#000000",
                    "label": "Button Label Color"
                },
                {
                    "type": "color",
                    "id": "button_background_color",
                    "default": "#00000000",
                    "label": "Button Background Color"
                },
                {
                    "type": "range",
                    "id": "button_font_size",
                    "label": "Button Font Size",
                    "default": 16,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                },
                {
                    "type": "checkbox",
                    "id": "button_show_icon",
                    "label": "Show Icon",
                    "default": true
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Test Hero",
            "blocks": [
                {
                    "type": "title",
                    "settings": {
                        "block_title": "Title"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "block_text": "Description text"
                    }
                },
                {
                    "type": "button",
                    "settings": {
                        "button_text": "Button"
                    }
                }
            ]
        }
    ]
  }
{% endschema %}