{% liquid
    assign hero_image = section.settings.hero_image
%}

<div
    id="Test-hero-{{ section.id }}"
    class="test-hero"
>
    <div class="test-hero__image">
        <img src="{{ section.settings.hero_image | img_url: 'master' | width: 1400 }}" alt="{{ section.settings.hero_title }}">
    </div>
    <div class="test-hero__content">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'title' %}
                    <h2
                        class="test-hero__title"
                        style="color: {{ block.settings.block_title_color }}; font-size: {{ block.settings.block_title_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.block_title }}
                    </h2>
                {% when 'text' %}
                    <p
                        class="test-hero__text"
                        style="color: {{ block.settings.block_text_color }}; font-size: {{ block.settings.block_text_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.block_text }}
                    </p>
                {% when 'button' %}
                    <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="test-hero__button"
                        style="color: {{ block.settings.button_color }}; font-size: {{ block.settings.button_font_size }}px;"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.button_text }}
                    </a>
            {% endcase %}
        {% endfor %}
    </div>
</div>


{% stylesheet %}
    .test-hero {
        position: relative;
        min-height: 60vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .test-hero__image {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .test-hero__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
    }

    .test-hero__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-align: center;
        padding: 40px 24px;
    }

    .test-hero__title,
    .test-hero__text {
        margin: 0;
    }

    .test-hero__button {
        display: inline-block;
        text-decoration: none;
        border: 1px solid currentColor;
        padding: 12px 24px;
    }
{% endstylesheet %}

{% schema %}
  {
    "name": "Test Hero",
    "tag": "section",
    "class": "test-hero-warpper section-wrapper",
    "settings": [
        {
            "type": "header",
            "content": "Test Hero"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero Image"
        }
    ],
    "blocks": [
        {
            "type": "title",
            "name": "Title",
            "settings": [
                {
                    "type": "text",
                    "id": "block_title",
                    "label": "Block Title"
                },
                {
                    "type": "color",
                    "id": "block_title_color",
                    "label": "Title color",
                    "default": "#000000"
                },
                {
                    "type": "range",
                    "id": "block_title_font_size",
                    "label": "Block Title Font Size",
                    "default": 48,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "text",
            "name": "Description",
            "settings": [
                {
                    "type": "text",
                    "id": "block_text",
                    "label": "Block Text"
                },
                {
                    "type": "color",
                    "id": "block_text_color",
                    "label": "Text color",
                    "default": "#000000"
                },
                {
                    "type": "range",
                    "id": "block_text_font_size",
                    "label": "Block Text Font Size",
                    "default": 16,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "button",
            "name": "Button",
            "settings": [
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button Text"
                },
                {
                    "type": "url",
                    "id": "button_link",
                    "label": "Button Link"
                },
                {
                    "type": "color",
                    "id": "button_color",
                    "default": "#000000",
                    "label": "Button Color"
                },
                {
                    "type": "range",
                    "id": "button_font_size",
                    "label": "Button Font Size",
                    "default": 16,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "px"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Test Hero",
            "blocks": [
                {
                    "type": "title",
                    "settings": {
                        "block_title": "Title"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "block_text": "Description text"
                    }
                },
                {
                    "type": "button",
                    "settings": {
                        "button_text": "Button"
                    }
                }
            ]
        }
    ]
  }
{% endschema %}